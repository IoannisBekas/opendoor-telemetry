# SEC EDGAR requires a descriptive User-Agent containing a contact email.
# Generic agents (curl/python-requests) are rejected with HTTP 403.
SEC_USER_AGENT="Opendoor Telemetry Research you@example.com"

# Free key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# PostgreSQL DSN
PG_DSN="postgresql://postgres:postgres@localhost:5432/opendoor"

# Local cache for conditional GETs and downloaded bulk files
CACHE_DIR=".cache"

# Politeness: requests/second per host
SEC_RATE_LIMIT=8.0
OPENDOOR_RATE_LIMIT=1.0
